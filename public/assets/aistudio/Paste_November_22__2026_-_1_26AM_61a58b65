import { Wrench, Plug, BookOpen, Home, Tent, PartyPopper, Trophy, Package } from 'lucide-react';
import { useState } from 'react';
const icons: any = { Tools: Wrench, Electronics: Plug, Education: BookOpen, Household: Home, Outdoor: Tent, Events: PartyPopper, Sports: Trophy, Other: Package };

export function ItemImage({ item, className = '' }: any) {
  const [bad, setBad] = useState(!item.image_url);
  const Icon = icons[item.category] || Package;
  if (bad) return <div className={`grid place-items-center bg-[var(--sun-soft)] ${className}`}><Icon className="h-14 w-14 text-[var(--blue)]/70" /></div>;
  return <img src={item.image_url} alt={item.name} loading="lazy" onError={() => setBad(true)} className={className} />;
}

export function ItemCard({ item, onOpen }: any) {
  const status = item.on_loan ? 'On loan' : item.is_available ? 'Available' : 'Unavailable';
  return (
    <motion.article layout whileHover={{ y: -6 }} transition={{ type: 'spring', stiffness: 300, damping: 22 }} onClick={() => onOpen(item.id)}
      className="group cursor-pointer overflow-hidden rounded-3xl border border-[var(--line)] bg-white shadow-[var(--shadow)]">
      <div className="relative aspect-[4/3] overflow-hidden bg-[var(--sun-soft)]">
        <ItemImage item={item} className="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
        <span className={`absolute left-3 top-3 rounded-full px-3 py-1 text-xs font-bold ${status === 'Available' ? 'bg-[var(--blue)] text-white' : 'bg-white text-[var(--muted)]'}`}>{status}</span>
      </div>
      <div className="space-y-1 p-4">
        <p className="text-xs font-bold text-[var(--orange)]">{item.category}</p>
        <h3 className="text-lg">{item.name}</h3>
        <p className="text-sm font-medium text-[var(--muted)]">{item.neighborhood} · {item.condition}</p>
        <div className="flex items-center justify-between pt-2">
          <span className="rounded-full bg-[var(--sun-soft)] px-3 py-1 text-xs font-extrabold">FREE</span>
          <span className="text-sm font-bold text-[var(--blue)]">View details →</span>
        </div>
      </div>
    </motion.article>
  );
}

export const SkeletonCard = () => (
  <div className="overflow-hidden rounded-3xl border border-[var(--line)] bg-white">
    <div className="shimmer aspect-[4/3]" />
    <div className="space-y-2 p-4"><div className="shimmer h-3 w-1/3 rounded-full" /><div className="shimmer h-5 w-3/4 rounded-full" /><div className="shimmer h-3 w-1/2 rounded-full" /></div>
  </div>
);
