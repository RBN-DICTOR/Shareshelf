### Stepper.tsx (animated request progress)
```tsx
const steps = ['Requested', 'Approved', 'Picked up', 'Returned', 'Complete'];
const idx: any = { pending: 0, approved: 1, active: 2, return_requested: 3, completed: 4 };
export function Stepper({ status }: { status: string }) {
  const cur = idx[status] ?? 0;
  if (status === 'rejected' || status === 'cancelled')
    return <p className="text-sm font-bold text-[var(--danger)]">{status === 'rejected' ? 'Not approved this time' : 'Request cancelled'}</p>;
  return (
    <div className="relative flex justify-between">
      <div className="absolute left-7 right-7 top-[13px] h-1 rounded-full bg-[var(--line)]">
        <motion.div className="h-full rounded-full bg-[var(--blue)]" initial={{ width: 0 }} animate={{ width: `${(cur / (steps.length - 1)) * 100}%` }} transition={{ duration: 0.6, ease: 'easeOut' }} />
      </div>
      {steps.map((s, i) => (
        <div key={s} className="relative z-10 flex w-14 flex-col items-center gap-1 text-center">
          <motion.span animate={{ scale: i === cur ? 1.15 : 1 }}
            className={`grid h-7 w-7 place-items-center rounded-full border-2 text-xs font-extrabold ${i <= cur ? 'border-[var(--blue)] bg-[var(--blue)] text-white' : 'border-[var(--line)] bg-white text-[var(--muted)]'}`}>
            {i < cur ? '✓' : i + 1}
          </motion.span>
          <span className="text-[10px] font-bold leading-tight">{s}</span>
        </div>
      ))}
    </div>
  );
}
```

