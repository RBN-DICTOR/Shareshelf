### Motion helpers: Reveal, Headline, Page, CountUp
```tsx
import { motion, useInView, useMotionValue, useTransform, animate } from 'framer-motion';
import { useEffect, useRef } from 'react';

export const Reveal = ({ children, delay = 0 }: any) => (
  <motion.div initial={{ opacity: 0, y: 24 }} whileInView={{ opacity: 1, y: 0 }} viewport={{ once: true, margin: '-60px' }}
    transition={{ duration: 0.5, delay, ease: [0.22, 1, 0.36, 1] }}>{children}</motion.div>
);

export function Headline({ text }: { text: string }) {
  return (
    <h1 className="text-5xl md:text-7xl">
      {text.split(' ').map((w, i) => (
        <span key={i} className="inline-block overflow-hidden align-bottom">
          <motion.span className="inline-block" initial={{ y: '110%' }} animate={{ y: 0 }}
            transition={{ delay: 0.1 + i * 0.07, duration: 0.6, ease: [0.22, 1, 0.36, 1] }}>{w}&nbsp;</motion.span>
        </span>
      ))}
    </h1>
  );
}

export const Page = ({ children }: any) => (
  <motion.main initial={{ opacity: 0, y: 14 }} animate={{ opacity: 1, y: 0 }} exit={{ opacity: 0 }} transition={{ duration: 0.3 }}>{children}</motion.main>
);

export function CountUp({ to, prefix = '', duration = 1.2 }: any) {
  const ref = useRef<HTMLSpanElement>(null);
  const inView = useInView(ref, { once: true });
  const mv = useMotionValue(0);
  const text = useTransform(mv, (v) => prefix + Math.round(v).toLocaleString());
  useEffect(() => { if (inView) { const c = animate(mv, to, { duration, ease: 'easeOut' }); return () => c.stop(); } }, [inView, to]);
  return <motion.span ref={ref}>{text}</motion.span>;
}
```
