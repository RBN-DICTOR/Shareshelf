# PART 2: SUPABASE SETUP

1. Create a Supabase project. Under **Authentication > Providers > Email**, turn **off** "Confirm email" so sign-up is instant.
2. Under **Authentication > Users > Add user**, create two users with "Auto confirm" on:
   - `alex@shareshelf.demo` / `ShareShelf!2026`
   - `jordan@shareshelf.demo` / `ShareShelf!2026`
3. Open **SQL Editor**, paste the whole block below, and run it.
4. Copy your **Project URL** and **anon public key** from Project Settings > API.

```sql
-- ============ EXTENSIONS ============
create extension if not exists btree_gist;

-- ============ TABLES ============
create table profiles (
  id uuid primary key references auth.users(id) on delete cascade,
  full_name text not null default 'Neighbor',
  neighborhood text,
  created_at timestamptz default now()
);

create table items (
  id uuid primary key default gen_random_uuid(),
  owner_id uuid not null references profiles(id) on delete cascade,
  name text not null,
  description text not null,
  category text not null check (category in ('Tools','Electronics','Education','Household','Outdoor','Events','Sports','Other')),
  condition text not null default 'Good' check (condition in ('Like new','Good','Fair')),
  image_url text,
  neighborhood text not null,
  is_available boolean not null default true,
  rules text default 'Please return it on time and in the condition you received it.',
  replacement_value numeric not null default 0,
  is_demo boolean not null default false,
  created_at timestamptz default now()
);

create table borrow_requests (
  id uuid primary key default gen_random_uuid(),
  item_id uuid not null references items(id) on delete cascade,
  borrower_id uuid not null references profiles(id) on delete cascade,
  owner_id uuid not null references profiles(id) on delete cascade,
  start_date date not null,
  end_date date not null,
  message text,
  status text not null default 'pending' check (status in ('pending','approved','rejected','active','return_requested','completed','cancelled')),
  is_demo boolean not null default false,
  created_at timestamptz default now(),
  updated_at timestamptz default now(),
  check (end_date >= start_date),
  -- The database itself refuses two reserved loans of one item on overlapping dates
  exclude using gist (item_id with =, daterange(start_date, end_date, '[]') with &&)
    where (status in ('approved','active','return_requested'))
);

create table item_wants (
  id uuid primary key default gen_random_uuid(),
  requester_id uuid not null references profiles(id) on delete cascade,
  title text not null,
  description text,
  category text not null,
  neighborhood text not null,
  needed_by date not null,
  status text not null default 'open' check (status in ('open','fulfilled')),
  is_demo boolean not null default false,
  created_at timestamptz default now()
);

create table want_responses (
  id uuid primary key default gen_random_uuid(),
  want_id uuid not null references item_wants(id) on delete cascade,
  responder_id uuid not null references profiles(id) on delete cascade,
  message text not null,
  created_at timestamptz default now()
);

create table notifications (
  id uuid primary key default gen_random_uuid(),
  user_id uuid not null references profiles(id) on delete cascade,
  message text not null,
  is_read boolean not null default false,
  created_at timestamptz default now()
);

-- ============ AUTO-CREATE PROFILE ON SIGN-UP ============
create or replace function handle_new_user() returns trigger
language plpgsql security definer set search_path = public as $$
begin
  insert into profiles (id, full_name)
  values (new.id, coalesce(new.raw_user_meta_data->>'full_name', split_part(new.email,'@',1)));
  return new;
end $$;
create trigger on_auth_user_created after insert on auth.users
  for each row execute function handle_new_user();

-- ============ BACK-FILL PROFILES FOR USERS CREATED BEFORE THE TRIGGER ============
insert into profiles (id, full_name)
select id, split_part(email,'@',1) from auth.users on conflict do nothing;

-- ============ STATUS RULES: who may move a request to which status ============
create or replace function enforce_request_transition() returns trigger
language plpgsql as $$
begin
  new.updated_at = now();
  if old.status = new.status then return new; end if;
  if auth.uid() = old.owner_id and (old.status, new.status) in
     (('pending','approved'),('pending','rejected'),('return_requested','completed')) then return new; end if;
  if auth.uid() = old.borrower_id and (old.status, new.status) in
     (('pending','cancelled'),('approved','cancelled'),('approved','active'),('active','return_requested')) then return new; end if;
  raise exception 'That status change is not allowed';
end $$;
create trigger request_transition before update on borrow_requests
  for each row execute function enforce_request_transition();

-- ============ AUTOMATIC NOTIFICATIONS ============
create or replace function notify_request_change() returns trigger
language plpgsql security definer set search_path = public as $$
declare item_name text;
begin
  select name into item_name from items where id = new.item_id;
  if tg_op = 'INSERT' then
    insert into notifications (user_id, message) values (new.owner_id, 'New request to borrow ' || item_name);
  elsif old.status <> new.status then
    insert into notifications (user_id, message) values (
      case when new.status in ('approved','rejected','completed') then new.borrower_id else new.owner_id end,
      'Your ' || item_name || ' request is now ' || replace(new.status, '_', ' '));
  end if;
  return new;
end $$;
create trigger request_notify after insert or update on borrow_requests
  for each row execute function notify_request_change();

create or replace function notify_want_response() returns trigger
language plpgsql security definer set search_path = public as $$
begin
  insert into notifications (user_id, message)
  select requester_id, 'A neighbor responded to your request for ' || title from item_wants where id = new.want_id;
  return new;
end $$;
create trigger want_response_notify after insert on want_responses
  for each row execute function notify_want_response();

-- ============ ROW LEVEL SECURITY ============
alter table profiles enable row level security;
alter table items enable row level security;
alter table borrow_requests enable row level security;
alter table item_wants enable row level security;
alter table want_responses enable row level security;
alter table notifications enable row level security;

create policy "profiles readable" on profiles for select using (true);
create policy "own profile update" on profiles for update using (auth.uid() = id);

create policy "items readable" on items for select using (true);
create policy "owner adds items" on items for insert with check (auth.uid() = owner_id);
create policy "owner edits items" on items for update using (auth.uid() = owner_id);
create policy "owner deletes items" on items for delete using (auth.uid() = owner_id);

create policy "parties read requests" on borrow_requests for select using (auth.uid() in (borrower_id, owner_id));
create policy "borrower creates request" on borrow_requests for insert with check (
  auth.uid() = borrower_id and status = 'pending' and borrower_id <> owner_id
  and owner_id = (select i.owner_id from items i where i.id = item_id));
create policy "parties update requests" on borrow_requests for update using (auth.uid() in (borrower_id, owner_id));

create policy "wants readable" on item_wants for select using (true);
create policy "requester adds want" on item_wants for insert with check (auth.uid() = requester_id);
create policy "requester edits want" on item_wants for update using (auth.uid() = requester_id);
create policy "requester deletes want" on item_wants for delete using (auth.uid() = requester_id);

create policy "responses readable" on want_responses for select using (true);
create policy "user adds response" on want_responses for insert with check (auth.uid() = responder_id);

create policy "own notifications read" on notifications for select using (auth.uid() = user_id);
create policy "own notifications update" on notifications for update using (auth.uid() = user_id);

-- ============ PUBLIC VIEWS (no personal data) ============
create or replace view item_busy_dates as
  select item_id, start_date, end_date, status from borrow_requests
  where status in ('approved','active','return_requested');

create or replace view community_impact as
select
  (select count(*) from items) as items_listed,
  (select count(*) from borrow_requests where status = 'completed') as completed_exchanges,
  (select count(*) from borrow_requests where status in ('active','return_requested')) as borrowed_now,
  (select coalesce(sum(i.replacement_value),0) from borrow_requests r join items i on i.id = r.item_id where r.status = 'completed') as money_saved,
  (select count(distinct item_id) from borrow_requests where status = 'completed') as items_reused,
  (select count(*) from items where is_demo) as demo_items;

grant select on item_busy_dates, community_impact to anon, authenticated;

-- ============ IMAGE STORAGE ============
insert into storage.buckets (id, name, public) values ('item-images','item-images', true) on conflict do nothing;
create policy "public read item images" on storage.objects for select using (bucket_id = 'item-images');
create policy "signed-in upload item images" on storage.objects for insert to authenticated with check (bucket_id = 'item-images');

-- ============ REALTIME (live updates between Alex and Jordan) ============
alter publication supabase_realtime add table items, borrow_requests, item_wants, want_responses, notifications;

-- ============ DEMO DATA (needs the two demo users from step 2) ============
do $$
declare a uuid; j uuid;
begin
  select id into a from auth.users where email = 'alex@shareshelf.demo';
  select id into j from auth.users where email = 'jordan@shareshelf.demo';
  update profiles set full_name = 'Alex Morgan', neighborhood = 'Riverside' where id = a;
  update profiles set full_name = 'Jordan Lee', neighborhood = 'Westlands' where id = j;

  insert into items (owner_id, name, description, category, condition, neighborhood, replacement_value, is_demo) values
  (a,'Cordless power drill','18V drill with two batteries, charger and a bit set.','Tools','Good','Riverside',80,true),
  (a,'Extension ladder','3 metre aluminium ladder, good for gutters and painting.','Tools','Good','Riverside',120,true),
  (a,'4-person camping tent','Easy pop-up tent with rain cover and carry bag.','Outdoor','Good','Riverside',90,true),
  (a,'HD projector','HDMI projector with a small tripod. Great for movie nights.','Electronics','Like new','Riverside',250,true),
  (a,'Home tool kit','Hammer, screwdrivers, pliers, spanner and spirit level.','Tools','Good','Riverside',55,true),
  (a,'Folding chairs (set of 6)','Six sturdy folding chairs for parties and gatherings.','Events','Good','Riverside',70,true),
  (j,'Scientific calculator','Exam-approved scientific calculator, fresh battery.','Education','Like new','Westlands',25,true),
  (j,'Football','Size 5 match ball, pumped and ready.','Sports','Good','Westlands',20,true),
